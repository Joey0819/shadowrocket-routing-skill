*.pyc
.env
.env.*
*.pem
*.key
*.pcap
*.pcapng
*.db
*.log
snapshot.json
endpoints.json
verification*.json
# Portable packages and private per-machine plans are generated, never published as source.
dist/
build/
private/
.runtime/
*.new-*
